# consultorIA — variables de entorno
# Copiá este archivo como .env.local SOLO si necesitás cambiar algo en tu computadora.
# Sin ninguna variable, `npm run dev` funciona con una base PostgreSQL embebida en .data/

# ---------------------------------------------------------------------------
# Base de datos (OBLIGATORIA en producción)
# Conexión PostgreSQL (Neon, Supabase u otra). En Vercel la integración de Neon
# crea DATABASE_URL automáticamente. Se usa solo desde el servidor.
DATABASE_URL=

# Solo desarrollo/pruebas: carpeta de la base embebida (":memory:" = sin persistencia)
# PGLITE_DIR=.data/pglite

# ---------------------------------------------------------------------------
# Acceso (OBLIGATORIO en producción)
# Clave que se escribe una vez por dispositivo. Cambiarla cierra todas las sesiones.
CLAVE_CONSULTORIO=
# Secreto para firmar las sesiones (cadena aleatoria larga). Opcional pero recomendado.
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Inteligencia artificial (opcional: sin clave, el asistente funciona en modo básico
# y las facturas se cargan a mano). Claves privadas: nunca en variables NEXT_PUBLIC_*.
#
# Gemini (Google) — proveedor principal. Clave en https://aistudio.google.com/apikey
# Plan gratuito: cupo chico por minuto y por día, y Google puede usar y revisar lo que
# se envía para mejorar sus productos (no enviar datos de pacientes). Con facturación
# activada en Google, los datos no se usan para eso.
GEMINI_API_KEY=
#
# Alternativa: Claude (Anthropic). Si hay clave de Gemini, se usa Gemini salvo que
# IA_PROVEEDOR=claude.
# ANTHROPIC_API_KEY=
# IA_PROVEEDOR=gemini
#
# Modelos (opcionales). Por defecto con Gemini: gemini-flash-lite-latest (asistente) y
# gemini-flash-latest (facturas); con Claude: claude-haiku-5-5 y claude-opus-5-5.
# IA_MODELO_ASISTENTE=
# IA_MODELO_FACTURAS=

# ---------------------------------------------------------------------------
# Archivos de facturas (opcional). En Vercel lo crea la integración de Blob (privado).
BLOB_READ_WRITE_TOKEN=
# Solo desarrollo: carpeta local para archivos
# ARCHIVOS_DIR=.data/archivos
